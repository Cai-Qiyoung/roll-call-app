page {
  background: #fff6ec;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
  color: #323233;
}

.container {
  padding: 24rpx 24rpx 60rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 53, 0.08);
  margin-bottom: 24rpx;
}

.big-btn {
  margin-top: 20rpx;
  text-align: center;
  background: linear-gradient(135deg, #7c4dff, #536dfe);
  color: #ffffff;
  border-radius: 56rpx;
  padding: 30rpx 0;
  font-size: 34rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 30rpx rgba(124, 77, 255, 0.35);
}

.big-btn.pressed {
  transform: scale(0.97);
  opacity: 0.9;
}

.chip {
  display: inline-block;
  background: #fff3e9;
  color: #ff6b35;
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  margin: 8rpx 6rpx 0 0;
}

.panel {
  padding: 40rpx 32rpx 60rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 24rpx;
}

.opt {
  display: inline-block;
  padding: 14rpx 26rpx;
  border-radius: 32rpx;
  background: #f5f5f5;
  color: #666666;
  font-size: 26rpx;
  border: 2rpx solid transparent;
  margin: 0 12rpx 16rpx 0;
}

.opt.sel {
  background: #fff3e9;
  color: #ff6b35;
  border-color: #ff9a3c;
  font-weight: 600;
}

.pick-list {
  max-height: 520rpx;
}

.pick-item {
  display: block;
  margin-bottom: 4rpx;
}