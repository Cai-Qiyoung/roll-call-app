.hero {
  background: linear-gradient(135deg, #ff9a3c 0%, #ff5f6d 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(255, 107, 53, 0.35);
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-sub {
  opacity: 0.92;
  font-size: 26rpx;
  margin-top: 12rpx;
}

.seg {
  display: flex;
  background: #ffe8d6;
  border-radius: 44rpx;
  padding: 8rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 36rpx;
  color: #b26a3f;
  font-size: 28rpx;
}

.seg-item.on {
  background: linear-gradient(135deg, #ff9a3c, #ff5f6d);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 53, 0.4);
}

.thursday-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.thursday-label {
  font-size: 26rpx;
  color: #666666;
}

.stage {
  text-align: center;
  padding: 64rpx 32rpx;
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.badge-row {
  margin-bottom: 16rpx;
}

.badge {
  display: inline-block;
  background: #fff3e0;
  color: #ff6b35;
  border: 2rpx solid #ffd9b3;
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
  font-size: 24rpx;
  margin: 0 8rpx;
}

.name {
  font-size: 92rpx;
  font-weight: 800;
  color: #ff5f6d;
  margin: 16rpx 0 8rpx;
}

.name.rolling {
  animation: bounce 0.18s linear infinite;
}

.name.pop {
  animation: pop 0.4s ease;
}

@keyframes bounce {
  0% { transform: scale(1); }
  50% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

@keyframes pop {
  0% { transform: scale(1.5); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.meta {
  font-size: 26rpx;
  color: #999999;
  margin-top: 8rpx;
}

.empty-name {
  font-size: 120rpx;
}

.chips {
  margin-top: 24rpx;
}

.actions {
  margin-top: 32rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

.act {
  padding: 16rpx 28rpx;
  background: #f5f0ff;
  color: #7c4dff;
  border-radius: 40rpx;
  font-size: 26rpx;
  margin: 10rpx;
  font-weight: 500;
}

.act.primary {
  background: linear-gradient(135deg, #ff9a3c, #ff5f6d);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.35);
}

.act.score-act {
  background: linear-gradient(135deg, #00c2a8, #00a3c2);
  color: #ffffff;
}

.group-title {
  font-size: 26rpx;
  color: #999999;
  margin: 28rpx 0 14rpx;
}

.sub-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #ff6b35;
  background: #fff3e9;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
}

.panel-btn {
  margin-top: 36rpx;
  text-align: center;
  background: linear-gradient(135deg, #ff9a3c, #ff5f6d);
  color: #ffffff;
  border-radius: 44rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 600;
}