.stats {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat {
  flex: 1;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 0;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 53, 0.08);
}

.stat .num {
  font-size: 44rpx;
  font-weight: 700;
  color: #ff6b35;
}

.stat .label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.chart-canvas {
  width: 100%;
  height: 560rpx;
  display: block;
}

.legend {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.dot {
  display: inline-block;
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  margin: 0 10rpx 0 16rpx;
}

.dot-score {
  background: #ff9a3c;
}

.dot-roll {
  background: #7c4dff;
}

.legend-2 {
  margin-left: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f7f3ee;
}

.row:last-child {
  border-bottom: none;
}

.rank {
  width: 72rpx;
  font-size: 36rpx;
  text-align: center;
  color: #333333;
}

.info {
  flex: 1;
}

.nm {
  font-size: 30rpx;
  font-weight: 600;
}

.no {
  font-size: 24rpx;
  color: #999999;
  font-weight: 400;
  margin-left: 6rpx;
}

.sub {
  font-size: 24rpx;
  color: #b0a8a0;
  margin-top: 4rpx;
}

.sc {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff6b35;
}

.empty {
  text-align: center;
  color: #c8c9cc;
  padding: 60rpx 0;
}