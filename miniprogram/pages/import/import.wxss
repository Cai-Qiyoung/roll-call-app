.hero {
  background: linear-gradient(135deg, #00c2a8, #00a3c2);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(0, 162, 194, 0.3);
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-sub {
  opacity: 0.92;
  font-size: 26rpx;
  margin-top: 12rpx;
}

.ops {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.op-btn {
  flex: 1;
  text-align: center;
  background: linear-gradient(135deg, #ff9a3c, #ff5f6d);
  color: #ffffff;
  border-radius: 44rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 600;
}

.op-btn.light {
  background: #ffffff;
  color: #ff6b35;
  border: 2rpx solid #ffd9b3;
}

.cell-value {
  color: #00a3c2;
  font-size: 24rpx;
}

.del-btn {
  height: 100%;
  width: 130rpx;
  background: #ee0a24;
  color: #ffffff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty {
  text-align: center;
  color: #999999;
  padding: 80rpx 0;
}

.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #c0b8b0;
  margin-top: 12rpx;
}

.danger-btn {
  margin-top: 24rpx;
  text-align: center;
  border: 2rpx solid #ffb3b3;
  color: #ee0a24;
  border-radius: 44rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
}